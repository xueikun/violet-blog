---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/url";
---

<BaseLayout title="404" description="页面不存在">
  <div class="wrap lost">
    <p class="code">404</p>
    <h1 class="lost-title">这封信没有寄到</h1>
    <p class="lost-desc">
      你要找的页面不存在,或者已经搬走了。<br />
      地址可能是敲错了,也可能它从来没写过。
    </p>
    <div class="acts">
      <a class="btn" href={url("")}>回到首页</a>
      <a class="btn btn-ghost" href={url("posts/")}>去看看文章</a>
    </div>
  </div>
</BaseLayout>

<style>
  .lost {
    padding: 110px 24px 140px;
    text-align: center;
    max-width: 560px;
  }

  .code {
    font-family: var(--font-serif);
    font-size: 88px;
    line-height: 1;
    color: var(--primary);
    letter-spacing: 0.06em;
    opacity: 0.85;
  }

  .lost-title {
    margin-top: 14px;
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 500;
  }

  .lost-desc {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--text-muted);
  }

  .acts {
    margin-top: 34px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
