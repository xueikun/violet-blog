---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../utils/date";
import { url } from "../utils/url";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const groups = new Map<string, typeof posts>();
for (const p of posts) {
  const key = `${p.data.date.getFullYear()}-${String(
    p.data.date.getMonth() + 1
  ).padStart(2, "0")}`;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(p);
}

const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort(
  (a, b) => b - a
);
---

<BaseLayout title="归档" description="按时间翻阅全部文章">
  <div class="wrap page">
    <h1 class="sec-title">
      归档 <span class="sec-sub">{posts.length} 篇 · {years.length} 年</span>
    </h1>

    <div class="years">
      {years.map((y) => <a class="pill" href={`#y${y}`}>{y}</a>)}
    </div>

    {
      years.map((year) => (
        <section class="year-block" id={`y${year}`}>
          <h2 class="year-title">{year}</h2>

          {[...groups.entries()]
            .filter(([key]) => key.startsWith(String(year)))
            .map(([key, items]) => (
              <div class="month reveal">
                <div class="month-label">
                  {Number(key.split("-")[1])} 月
                  <span class="month-count">{items.length}</span>
                </div>
                <ul class="timeline">
                  {items.map((post) => (
                    <li class="tl-item">
                      <span class="tl-dot" aria-hidden="true" />
                      <time datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date).slice(5)}
                      </time>
                      <a class="tl-link" href={url(`posts/${post.id}/`)}>
                        {post.data.title}
                      </a>
                      <span class="tl-cat">{post.data.category}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .years {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
  }

  .year-block {
    margin-bottom: 40px;
    scroll-margin-top: 90px;
  }

  .year-title {
    font-size: 26px;
    color: var(--primary);
    font-family: var(--font-mono);
    margin-bottom: 18px;
  }

  .month {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 20px;
    padding-bottom: 24px;
  }

  .month-label {
    font-size: 13.5px;
    color: var(--text-muted);
    padding-top: 2px;
    position: relative;
  }

  .month-count {
    margin-left: 6px;
    font-size: 11.5px;
    padding: 0 7px;
    border-radius: var(--radius-pill);
    background: var(--primary-soft);
    color: var(--primary-strong);
  }

  .timeline {
    list-style: none;
    border-left: 1.5px dashed var(--border);
    padding-left: 22px;
    margin-left: 4px;
  }

  .tl-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 7px 0;
    position: relative;
    font-size: 15px;
  }

  .tl-dot {
    position: absolute;
    left: -29px;
    top: 15px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--primary);
    transition: background var(--dur) var(--ease);
  }

  .tl-item:hover .tl-dot {
    background: var(--primary);
  }

  .tl-item time {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-faint);
    flex: none;
  }

  .tl-link {
    color: var(--text);
  }

  .tl-link:hover {
    color: var(--primary-strong);
  }

  .tl-cat {
    margin-left: auto;
    font-size: 12px;
    color: var(--text-faint);
    flex: none;
  }

  @media (max-width: 640px) {
    .month {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .tl-item {
      flex-wrap: wrap;
      gap: 6px 12px;
    }
    .tl-cat {
      margin-left: 0;
    }
  }
</style>
