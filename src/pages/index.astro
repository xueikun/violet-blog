---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import HeroArt from "../components/HeroArt.astro";
import site from "../data/site.json";
import { buildTags } from "../utils/tags";
import { url } from "../utils/url";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => {
    if (a.data.top !== b.data.top) return a.data.top ? -1 : 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  }
);

const latest = posts.slice(0, 6);

const tags = buildTags(posts);
const maxCount = Math.max(...tags.map((t) => t.posts.length), 1);
---

<BaseLayout
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      name: site.name,
      description: site.description,
      inLanguage: "zh-CN",
      blogPost: latest.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        datePublished: post.data.date.toISOString(),
        url: url(`posts/${post.id}/`),
      })),
    },
  ]}
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="hero-kicker">// {site.latin}</p>
        <h1 class="hero-title">{site.name}</h1>
        <p class="hero-sub">
          <span id="typed" data-text={site.subtitle}></span><span
            class="caret"
            aria-hidden="true">_</span
          >
        </p>
        <p class="hero-desc">{site.description}</p>
        <div class="hero-actions">
          <a class="btn" href={url("posts/")}>开始阅读</a>
          <a class="btn btn-ghost" href={url("about/")}>关于我</a>
        </div>
      </div>

      <div class="hero-art">
        <HeroArt size={296} />
      </div>
    </div>
  </section>

  <section class="wrap block">
    <h2 class="sec-title">
      最新文章 <span class="sec-sub">共 {posts.length} 篇</span>
    </h2>
    <div class="grid">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
    <div class="more">
      <a href={url("posts/")}>查看全部文章 →</a>
    </div>
  </section>

  <section class="wrap block">
    <h2 class="sec-title">
      标签云 <span class="sec-sub">按出现次数排序</span>
    </h2>
    <div class="tagcloud">
      {
        tags.map((t) => (
          <a
            class="pill"
            href={url(`tags/${t.slug}/`)}
            style={`font-size:${(12 + (t.posts.length / maxCount) * 4).toFixed(1)}px`}
          >
            {t.tag} <em>{t.posts.length}</em>
          </a>
        ))
      }
    </div>
    <div class="more">
      <a href={url("tags/")}>查看全部标签 →</a>
    </div>
  </section>
</BaseLayout>

<script>
  const target = document.getElementById("typed");
  if (target) {
    const full = target.dataset.text ?? "";
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
      .matches;

    if (reduce) {
      target.textContent = full;
    } else {
      let i = 0;
      const tick = () => {
        target.textContent = full.slice(0, i);
        i += 1;
        if (i <= full.length) window.setTimeout(tick, 95);
      };
      window.setTimeout(tick, 320);
    }
  }
</script>

<style>
  .hero {
    padding: 64px 0 24px;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: center;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-faint);
    letter-spacing: 0.06em;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 46px;
    font-weight: 500;
    line-height: 1.25;
    margin-top: 6px;
    letter-spacing: 0.03em;
  }

  .hero-sub {
    margin-top: 6px;
    font-size: 19px;
    color: var(--primary-strong);
    min-height: 30px;
  }

  .caret {
    animation: blink 1s step-end infinite;
    color: var(--primary);
  }

  .hero-desc {
    margin-top: 16px;
    max-width: 34ch;
    font-size: 14.5px;
    color: var(--text-muted);
  }

  .hero-actions {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-art {
    display: grid;
    place-items: center;
  }

  .block {
    padding-top: 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
    gap: 20px;
  }

  .more {
    margin-top: 28px;
    text-align: center;
    font-size: 14px;
  }

  .tagcloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tagcloud em {
    font-style: normal;
    font-size: 0.8em;
    opacity: 0.6;
    margin-left: 2px;
  }

  @media (max-width: 780px) {
    .hero {
      padding: 40px 0 8px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .hero-art {
      order: -1;
      justify-content: start;
    }
    .hero-art :global(svg) {
      width: 190px;
      height: 190px;
    }
    .hero-title {
      font-size: 34px;
    }
    .hero-sub {
      font-size: 17px;
    }
  }
</style>
