---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";

const skills = [
  { name: "Java / Spring Boot", level: 85 },
  { name: "MySQL / MyBatis-Plus", level: 78 },
  { name: "HTML / CSS / JavaScript", level: 62 },
  { name: "Vue / React", level: 55 },
  { name: "Linux / 部署运维", level: 46 },
];

const timeline = [
  { time: "2026", text: "开始写这个博客,想留下点东西" },
  { time: "2025", text: "在毕业设计里第一次把一套系统完整跑起来" },
  { time: "2023", text: "决定以此谋生,开始系统学 Java" },
];

const watching = [
  "本季度在追 7 部,其中 3 部续作",
  "游戏:在玩长线养成,进度缓慢",
  "音乐:写代码时的固定歌单循环中",
];
---

<BaseLayout title="关于" description="关于我">
  <div class="wrap page">
    <h1 class="sec-title">关于 <span class="sec-sub">who am i</span></h1>

    <div class="card sticker reveal">
      <div class="avatar" aria-hidden="true">✧</div>
      <div class="intro">
        <h2 class="name">{site.author}</h2>
        <p class="bio">{site.bio}</p>
        <p class="desc">{site.description}</p>
      </div>
    </div>

    <section class="block">
      <h2 class="sec-title">技能面板 <span class="sec-sub">自评,仅供参考</span></h2>
      <div class="skills sticker reveal">
        {
          skills.map((s) => (
            <div class="skill">
              <div class="skill-head">
                <span>{s.name}</span>
                <span class="skill-num">{s.level}</span>
              </div>
              <div class="bar">
                <div class="fill" style={`width:${s.level}%`} />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="block">
      <h2 class="sec-title">时间线</h2>
      <ul class="tl">
        {
          timeline.map((t) => (
            <li class="tl-row reveal">
              <span class="tl-year">{t.time}</span>
              <span class="tl-text">{t.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2 class="sec-title">最近在做什么</h2>
      <ul class="now sticker reveal">
        {watching.map((w) => <li>{w}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 26px 28px;
  }

  .avatar {
    width: 84px;
    height: 84px;
    flex: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 32px;
    color: var(--primary);
    background: linear-gradient(
      135deg,
      var(--primary-soft),
      var(--secondary-soft)
    );
    border: 1.5px solid var(--primary);
  }

  .name {
    font-size: 21px;
  }

  .bio {
    margin-top: 4px;
    font-size: 14px;
    color: var(--primary-strong);
  }

  .desc {
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .block {
    margin-top: 48px;
  }

  .skills {
    padding: 24px 28px;
    display: grid;
    gap: 18px;
  }

  .skill-head {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .skill-num {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .bar {
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .fill {
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      90deg,
      var(--secondary),
      var(--primary)
    );
  }

  .tl {
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .tl-row {
    display: flex;
    gap: 18px;
    align-items: baseline;
    padding-left: 18px;
    position: relative;
    font-size: 15px;
  }

  .tl-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
  }

  .tl-year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--primary-strong);
    flex: none;
  }

  .now {
    list-style: none;
    padding: 22px 28px;
    display: grid;
    gap: 10px;
    font-size: 14.5px;
    color: var(--text-muted);
  }

  .now li::before {
    content: "▸ ";
    color: var(--secondary);
  }

  @media (max-width: 560px) {
    .card {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
  }
</style>
