---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/date";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { data } = post;
---

<a
  class="card sticker sticker-hover reveal"
  data-tilt
  href={`/posts/${post.id}/`}
>
  <div class="cover">
    {
      data.cover ? (
        <img src={data.cover} alt={data.title} loading="lazy" />
      ) : (
        <span class="cover-ph" aria-hidden="true">✧</span>
      )
    }
    {data.mood && <span class="mood">{data.mood}</span>}
  </div>

  <div class="body">
    <div class="meta">
      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      <span class="cat">{data.category}</span>
    </div>

    <h3 class="title">{data.title}</h3>
    <p class="excerpt">{data.excerpt}</p>

    <div class="tags">
      {data.tags.map((tag) => <span class="pill">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 8;
    background: linear-gradient(
      135deg,
      var(--primary-soft),
      var(--secondary-soft)
    );
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms var(--ease);
  }

  .card:hover .cover img {
    transform: scale(1.04);
  }

  .cover-ph {
    font-size: 34px;
    color: var(--primary);
    opacity: 0.65;
    transition: transform 420ms var(--ease);
  }

  .card:hover .cover-ph {
    transform: rotate(20deg) scale(1.15);
  }

  .mood {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 1px 10px;
    font-size: 12px;
    border-radius: var(--radius-pill);
    background: var(--bg-elevated);
    color: var(--primary-strong);
    border: 1.5px solid var(--primary);
  }

  .body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .cat {
    padding: 0 8px;
    border-radius: var(--radius-pill);
    background: var(--secondary-soft);
    color: var(--text-muted);
  }

  .title {
    font-size: 17px;
    color: var(--text);
    transition: color var(--dur) var(--ease);
  }

  .card:hover .title {
    color: var(--primary-strong);
  }

  .excerpt {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
</style>
