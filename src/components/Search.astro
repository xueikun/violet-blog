---
import site from "../data/site.json";
import { url } from "../utils/url";
---

<div class="sm-mask" id="sm-mask" hidden>
  <div
    class="sm-panel"
    role="dialog"
    aria-modal="true"
    aria-label="站内搜索"
  >
    <div class="sm-field">
      <svg
        class="sm-ico"
        viewBox="0 0 16 16"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="7" cy="7" r="4.6"></circle>
        <path d="M10.6 10.6 L14.2 14.2"></path>
      </svg>
      <input
        id="sm-input"
        class="sm-input"
        type="search"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        placeholder={`在「${site.name}」里找点什么…`}
        aria-label="搜索关键词"
        aria-controls="sm-results"
      />
      <kbd class="sm-esc">Esc</kbd>
    </div>

    <div class="sm-body" id="sm-results" role="listbox" aria-live="polite"></div>

    <div class="sm-foot">
      <span class="sm-tip"><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span class="sm-tip"><kbd>↵</kbd> 打开</span>
      <span class="sm-tip"><kbd>Ctrl</kbd><kbd>K</kbd> 唤起</span>
      <span class="sm-count" id="sm-count"></span>
    </div>
  </div>
</div>

<script>
  // 站内路径一律走 url() —— 客户端拿到的 import.meta.env.BASE_URL 是不带尾斜杠的,
  // 直接拼会得到 /violet-blogsearch-index.json 这种坏地址。
  import { url } from "../utils/url";

  interface Hit {
    t: string; // 标题
    e: string; // 摘要
    c: string; // 分类
    g: string[]; // 标签
    d: string; // 日期
    u: string; // 链接
    b: string; // 正文纯文本
  }

  const mask = document.getElementById("sm-mask");
  const panel = mask?.querySelector<HTMLElement>(".sm-panel");
  const input = document.getElementById("sm-input") as HTMLInputElement | null;
  const box = document.getElementById("sm-results");
  const count = document.getElementById("sm-count");
  const opener = document.getElementById("search-open");

  if (mask && panel && input && box) {
    let index: Hit[] | null = null;
    let fetching: Promise<void> | null = null;
    let hits: Hit[] = [];
    let cursor = 0;
    let composing = false;
    let lastFocus: HTMLElement | null = null;

    /* ---------- 索引懒加载:首次唤起才请求 ---------- */
    function load(): Promise<void> {
      if (index) return Promise.resolve();
      if (!fetching) {
        fetching = fetch(url("search-index.json"))
          .then((r) => (r.ok ? r.json() : []))
          .then((data: Hit[]) => {
            index = Array.isArray(data) ? data : [];
          })
          .catch(() => {
            index = [];
          });
      }
      return fetching;
    }

    /* ---------- 工具 ---------- */
    const ESC_MAP: Record<string, string> = {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ESC_MAP[c]);
    const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    function mark(text: string, terms: string[]): string {
      let out = esc(text);
      if (!terms.length) return out;
      for (const term of [...terms].sort((a, b) => b.length - a.length)) {
        const re = new RegExp(escRe(esc(term)), "gi");
        out = out.replace(re, (m) => `\u0000${m}\u0001`);
      }
      return out
        .replace(/\u0000/g, '<mark class="sm-hl">')
        .replace(/\u0001/g, "</mark>");
    }

    function occurrences(hay: string, needle: string): number {
      if (!needle) return 0;
      let n = 0;
      let i = hay.indexOf(needle);
      while (i !== -1 && n < 20) {
        n += 1;
        i = hay.indexOf(needle, i + needle.length);
      }
      return n;
    }

    /** 取命中位置周围的一段正文做摘要 */
    function snippet(body: string, terms: string[]): string {
      const lower = body.toLowerCase();
      let at = -1;
      for (const term of terms) {
        const i = lower.indexOf(term);
        if (i !== -1 && (at === -1 || i < at)) at = i;
      }
      if (at === -1) return body.slice(0, 88);
      const start = Math.max(0, at - 30);
      const end = Math.min(body.length, at + 62);
      return (
        (start > 0 ? "…" : "") + body.slice(start, end) + (end < body.length ? "…" : "")
      );
    }

    /** 命中打分:标题 > 标签 > 分类 > 摘要 > 正文;多词为 AND 语义 */
    function score(item: Hit, terms: string[]): number {
      const title = item.t.toLowerCase();
      const excerpt = item.e.toLowerCase();
      const cat = item.c.toLowerCase();
      const tags = item.g.map((t) => t.toLowerCase());
      const body = item.b.toLowerCase();
      const hay = `${title}\n${excerpt}\n${cat}\n${tags.join("\n")}\n${body}`;

      let total = 0;
      for (const term of terms) {
        if (!hay.includes(term)) return 0;
        let s = 0;
        if (title.includes(term)) s += 60;
        if (title.startsWith(term)) s += 30;
        if (tags.includes(term)) s += 50;
        else if (tags.some((t) => t.includes(term))) s += 25;
        if (cat.includes(term)) s += 20;
        if (excerpt.includes(term)) s += 18;
        s += Math.min(occurrences(body, term), 8) * 2;
        total += s;
      }
      return total;
    }

    /* ---------- 渲染 ---------- */
    function render(terms: string[]) {
      if (!index) return;
      if (!terms.length) {
        hits = index.slice(0, 6);
        cursor = 0;
        box!.innerHTML = `<p class="sm-hint">输入关键词开始搜索 · 共收录 ${index.length} 篇文章</p>`;
        count && (count.textContent = "");
        return;
      }

      hits = index
        .map((item) => ({ item, s: score(item, terms) }))
        .filter((r) => r.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 20)
        .map((r) => r.item);

      cursor = 0;
      count && (count.textContent = `${hits.length} 条结果`);

      if (!hits.length) {
        // 注意:颜文字里的「`」必须用全角 ｀,否则会提前闭合上面的模板字符串
        box!.innerHTML = `<p class="sm-hint">没有找到「${esc(
          terms.join(" ")
        )}」· 换个词试试 (´・ω・｀)</p>`;
        return;
      }

      box!.innerHTML = hits
        .map(
          (item, i) => `
          <a class="sm-hit${i === 0 ? " on" : ""}" role="option" aria-selected="${
            i === 0
          }" data-i="${i}" href="${item.u}">
            <span class="sm-hit-head">
              <span class="sm-hit-title">${mark(item.t, terms)}</span>
              <span class="sm-hit-date">${item.d}</span>
            </span>
            <span class="sm-hit-snip">${mark(snippet(item.b, terms), terms)}</span>
            <span class="sm-hit-meta">
              <span class="sm-tag">${esc(item.c)}</span>
              ${item.g.map((t) => `<span class="sm-tag">${mark(t, terms)}</span>`).join("")}
            </span>
          </a>`
        )
        .join("");
    }

    function move(step: number) {
      const nodes = box!.querySelectorAll<HTMLElement>(".sm-hit");
      if (!nodes.length) return;
      cursor = (cursor + step + nodes.length) % nodes.length;
      nodes.forEach((n, i) => {
        const on = i === cursor;
        n.classList.toggle("on", on);
        n.setAttribute("aria-selected", String(on));
      });
      nodes[cursor].scrollIntoView({ block: "nearest" });
    }

    /* ---------- 开关 ---------- */
    function open() {
      lastFocus = document.activeElement as HTMLElement | null;
      mask!.hidden = false;
      document.body.style.overflow = "hidden";
      input!.value = "";
      box!.innerHTML = `<p class="sm-hint">载入索引…</p>`;
      input!.focus();
      load().then(() => render([]));
    }

    function close() {
      mask!.hidden = true;
      document.body.style.overflow = "";
      lastFocus?.focus?.();
    }

    /* ---------- 事件 ---------- */
    opener?.addEventListener("click", open);

    document.addEventListener("keydown", (e) => {
      const k = e.key.toLowerCase();
      if ((e.ctrlKey || e.metaKey) && k === "k") {
        e.preventDefault();
        mask.hidden ? open() : close();
        return;
      }
      if (mask.hidden) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        const node = box.querySelector<HTMLAnchorElement>(".sm-hit.on");
        if (node) {
          e.preventDefault();
          location.href = node.href;
        }
      }
    });

    input.addEventListener("compositionstart", () => (composing = true));
    input.addEventListener("compositionend", () => {
      composing = false;
      run();
    });
    input.addEventListener("input", () => {
      if (!composing) run();
    });

    /** 触发顺序:确保索引已就绪再做匹配 */
    function run() {
      const terms = input!.value
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean);
      if (!index) {
        load().then(() => render(terms));
        return;
      }
      render(terms);
    }

    mask.addEventListener("mousedown", (e) => {
      if (!panel!.contains(e.target as Node)) close();
    });

    // 点结果后收起浮层,避免浏览器前进时残留
    box.addEventListener("click", () => {
      document.body.style.overflow = "";
    });
  }
</script>

<style>
  .sm-mask {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 10vh 20px 20px;
    background: color-mix(in srgb, var(--bg-sunken) 62%, transparent);
    backdrop-filter: blur(6px);
    animation: smFade 180ms var(--ease);
  }

  .sm-mask[hidden] {
    display: none;
  }

  @keyframes smFade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .sm-panel {
    width: 100%;
    max-width: 620px;
    max-height: 74vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg-elevated);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 0 var(--primary-soft);
    animation: smRise 220ms var(--ease);
  }

  @keyframes smRise {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .sm-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 16px;
    border-bottom: 1.5px solid var(--border);
    flex: none;
  }

  .sm-ico {
    color: var(--primary);
    flex: none;
  }

  .sm-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: none;
    color: var(--text);
    font-family: inherit;
    font-size: 15.5px;
  }

  .sm-input::placeholder {
    color: var(--text-faint);
  }

  .sm-input::-webkit-search-cancel-button {
    display: none;
  }

  .sm-esc,
  .sm-foot kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 1px 6px;
    border-radius: 6px;
    color: var(--text-faint);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
  }

  .sm-body {
    overflow-y: auto;
    padding: 8px;
    flex: 1;
  }

  /* ---------- 以下结果区由 JS 注入 innerHTML,元素上没有 Astro 的作用域属性,
     所以必须用 :global() 才能命中。改这里时别忘了。 ---------- */

  .sm-body :global(.sm-hint) {
    display: block;
    padding: 28px 14px;
    text-align: center;
    font-size: 13.5px;
    color: var(--text-faint);
  }

  .sm-body :global(.sm-hit) {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    border: 1.5px solid transparent;
    color: var(--text);
  }

  .sm-body :global(.sm-hit.on) {
    background: var(--primary-soft);
    border-color: var(--primary);
  }

  .sm-body :global(.sm-hit-head) {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .sm-body :global(.sm-hit-title) {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    flex: 1;
    min-width: 0;
  }

  .sm-body :global(.sm-hit-date) {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .sm-body :global(.sm-hit-snip) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .sm-body :global(.sm-hit-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 7px;
  }

  .sm-body :global(.sm-tag) {
    padding: 0 8px;
    font-size: 11.5px;
    line-height: 1.7;
    border-radius: var(--radius-pill);
    background: var(--secondary-soft);
    color: var(--text-muted);
  }

  .sm-body :global(.sm-hl) {
    background: var(--accent-soft);
    color: var(--accent);
    font-style: normal;
    border-radius: 4px;
    padding: 0 2px;
  }

  .sm-foot {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 16px;
    border-top: 1.5px solid var(--border);
    background: var(--bg-sunken);
    font-size: 12px;
    color: var(--text-faint);
    flex: none;
  }

  .sm-tip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .sm-count {
    margin-left: auto;
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .sm-mask {
      padding: 6vh 14px 14px;
    }
    .sm-panel {
      max-height: 80vh;
    }
    .sm-foot {
      gap: 10px;
    }
    .sm-tip:nth-child(3) {
      display: none;
    }
  }
</style>
