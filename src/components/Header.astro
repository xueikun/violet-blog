---
import site from "../data/site.json";
import { url } from "../utils/url";

const nav = [
  { href: url(""), label: "首页" },
  { href: url("posts/"), label: "文章" },
  { href: url("archive/"), label: "归档" },
  { href: url("tags/"), label: "标签" },
  { href: url("guestbook/"), label: "留言" },
  { href: url("about/"), label: "关于" },
];

const home = url("");
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === home ? path === home : path.startsWith(href);
---

<header class="hd">
  <div class="wrap hd-inner">
    <a class="brand" href={url("")}>
      <span class="brand-mark" aria-hidden="true">✧</span>
      <span class="brand-text">{site.name}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="search-open"
      class="search-btn"
      type="button"
      aria-label="站内搜索"
      title="站内搜索 (Ctrl+K)"
    >
      <svg
        viewBox="0 0 16 16"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="7" cy="7" r="4.6"></circle>
        <path d="M10.6 10.6 L14.2 14.2"></path>
      </svg>
      <span class="search-kbd" aria-hidden="true">Ctrl K</span>
    </button>

    <button
      id="theme-toggle"
      class="theme-btn"
      type="button"
      aria-label="切换深浅主题"
      title="切换深浅主题"
    >
      <span class="ico ico-sun" aria-hidden="true">☀</span>
      <span class="ico ico-moon" aria-hidden="true">☾</span>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");

  btn?.addEventListener("click", () => {
    const next =
      root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {
      /* 隐私模式下忽略 */
    }
  });
</script>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1.5px solid var(--border);
  }

  .hd-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 66px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.05em;
    flex: none;
  }

  .brand-mark {
    color: var(--primary);
    font-size: 20px;
    line-height: 1;
  }

  .brand:hover .brand-mark {
    animation: spin 900ms var(--ease);
  }

  @keyframes spin {
    to {
      transform: rotate(180deg);
    }
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    color: var(--text-muted);
    border: 1.5px solid transparent;
    transition: all var(--dur) var(--ease);
  }

  .nav-link:hover {
    color: var(--primary-strong);
    background: var(--primary-soft);
  }

  .nav-link.active {
    color: var(--primary-strong);
    background: var(--primary-soft);
    border-color: var(--primary);
  }

  .theme-btn {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border);
    background: var(--bg-elevated);
    display: grid;
    place-items: center;
    font-size: 16px;
    color: var(--primary-strong);
    transition: all var(--dur) var(--ease);
  }

  .theme-btn:hover {
    border-color: var(--primary);
    transform: rotate(-15deg);
  }

  /* 搜索入口 —— 快捷键提示只在宽屏显示 */
  .search-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: 12.5px;
    transition: all var(--dur) var(--ease);
  }

  .search-btn:hover {
    color: var(--primary-strong);
    border-color: var(--primary);
  }

  .search-kbd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    color: var(--text-faint);
  }

  .ico-moon {
    display: none;
  }

  :global([data-theme="dark"]) .ico-sun {
    display: none;
  }

  :global([data-theme="dark"]) .ico-moon {
    display: block;
  }

  @media (max-width: 640px) {
    .hd-inner {
      height: 58px;
      gap: 6px;
    }
    .brand-text {
      display: none;
    }
    .brand-mark {
      font-size: 18px;
    }
    /* 导航项变多后窄屏放不下:先压缩间距,再不够就横向滚动 */
    .nav {
      min-width: 0;
      gap: 2px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* 纯 alpha 遮罩,非主题色 */
      mask-image: linear-gradient(90deg, #000 92%, transparent);
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .nav-link {
      padding: 6px 8px;
      font-size: 12.5px;
      white-space: nowrap;
    }
    .search-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      justify-content: center;
    }
    .search-kbd {
      display: none;
    }
    .theme-btn {
      width: 36px;
      height: 36px;
    }
  }
</style>
