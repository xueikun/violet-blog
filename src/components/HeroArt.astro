---
interface Props {
  size?: number;
}
const { size = 300 } = Astro.props;
---

<svg
  class="hero-art"
  width={size}
  height={size}
  viewBox="0 0 320 320"
  role="img"
  aria-label="信封与火漆印章的装饰插画"
>
  <defs>
    <linearGradient id="skyGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--primary-soft)"></stop>
      <stop offset="100%" stop-color="var(--secondary-soft)"></stop>
    </linearGradient>
  </defs>

  <circle cx="160" cy="160" r="146" fill="url(#skyGrad)"></circle>
  <circle
    cx="160"
    cy="160"
    r="146"
    fill="none"
    stroke="var(--primary)"
    stroke-width="1.5"
    opacity="0.55"></circle>
  <circle
    cx="160"
    cy="160"
    r="132"
    fill="none"
    stroke="var(--primary)"
    stroke-width="0.75"
    opacity="0.28"
    stroke-dasharray="3 7"></circle>

  <g class="sparkles">
    <path
      d="M74 88 Q77 97 86 100 Q77 103 74 112 Q71 103 62 100 Q71 97 74 88 Z"
      fill="var(--primary)"
    ></path>
    <path
      d="M246 96 Q248.5 103.5 256 106 Q248.5 108.5 246 116 Q243.5 108.5 236 106 Q243.5 103.5 246 96 Z"
      fill="var(--accent)"
    ></path>
    <path
      d="M250 214 Q252.5 221.5 260 224 Q252.5 226.5 250 234 Q247.5 226.5 240 224 Q247.5 221.5 250 214 Z"
      fill="var(--secondary)"
    ></path>
    <circle cx="92" cy="212" r="3" fill="var(--secondary)"></circle>
    <circle cx="196" cy="66" r="2.5" fill="var(--primary)"></circle>
    <circle cx="60" cy="152" r="2" fill="var(--accent)"></circle>
  </g>

  <g class="letter">
    <rect
      x="86"
      y="124"
      width="148"
      height="106"
      rx="8"
      fill="var(--bg-elevated)"
      stroke="var(--primary)"
      stroke-width="2"></rect>
    <path
      d="M92 220 L146 178"
      fill="none"
      stroke="var(--primary)"
      stroke-width="1.5"
      opacity="0.45"></path>
    <path
      d="M228 220 L174 178"
      fill="none"
      stroke="var(--primary)"
      stroke-width="1.5"
      opacity="0.45"></path>
    <path
      d="M86 124 L160 190 L234 124"
      fill="none"
      stroke="var(--primary)"
      stroke-width="2"
      stroke-linejoin="round"></path>
  </g>

  <g class="seal" transform="translate(160 190)">
    <circle r="17.5" fill="var(--accent)"></circle>
    <circle
      r="17.5"
      fill="none"
      stroke="var(--primary-strong)"
      stroke-width="1"
      opacity="0.35"></circle>
    <path
      d="M-6.5 -5 L0 6.5 L6.5 -5"
      fill="none"
      stroke="var(--bg-elevated)"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </g>

  <g class="bloom" transform="translate(66 176)">
    <g fill="var(--primary)" opacity="0.9">
      <ellipse cx="0" cy="-11" rx="6" ry="10"></ellipse>
      <ellipse cx="0" cy="-11" rx="6" ry="10" transform="rotate(72)"></ellipse>
      <ellipse cx="0" cy="-11" rx="6" ry="10" transform="rotate(144)"></ellipse>
      <ellipse cx="0" cy="-11" rx="6" ry="10" transform="rotate(216)"></ellipse>
      <ellipse cx="0" cy="-11" rx="6" ry="10" transform="rotate(288)"></ellipse>
    </g>
    <circle cx="0" cy="0" r="3" fill="var(--accent)"></circle>
  </g>
</svg>

<style>
  .hero-art {
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 0 var(--primary-soft));
  }

  .sparkles path,
  .sparkles circle {
    animation: twinkle 2.4s var(--ease) infinite alternate;
  }

  .sparkles path:nth-child(2) {
    animation-delay: 0.6s;
  }

  .sparkles path:nth-child(3) {
    animation-delay: 1.2s;
  }

  .letter {
    animation: lift 6s var(--ease) infinite alternate;
  }

  .bloom {
    animation: sway 5s var(--ease) infinite alternate;
  }

  @keyframes twinkle {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes lift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-5px);
    }
  }

  @keyframes sway {
    from {
      transform: translate(66px, 176px) rotate(0deg);
    }
    to {
      transform: translate(66px, 169px) rotate(13deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sparkles path,
    .sparkles circle,
    .letter,
    .bloom {
      animation: none;
    }
  }
</style>
